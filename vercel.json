{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/video.js": { "maxDuration": 60 },
    "api/video-publish.js": { "maxDuration": 60 },
    "api/aio-cron.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/weekly-report",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/social-cron",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "line-bot-omega-liard.vercel.app"
        }
      ],
      "destination": "https://lumenium.net/:path*",
      "permanent": true
    },
    {
      "source": "/sitemap-content.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/BingSiteAuth.xml",
      "destination": "/api/verify"
    },
    {
      "source": "/:file(google[0-9a-z]+\\.html)",
      "destination": "/api/verify"
    },
    {
      "source": "/links",
      "destination": "/api/links"
    },
    {
      "source": "/members/arena",
      "destination": "/api/members-game"
    },
    {
      "source": "/members/puzzle",
      "destination": "/api/members-puzzle"
    },
    {
      "source": "/members/territory",
      "destination": "/api/members-territory"
    },
    {
      "source": "/game.html",
      "destination": "/game.html"
    },
    {
      "source": "/racing.html",
      "destination": "/racing.html"
    },
    {
      "source": "/runner.html",
      "destination": "/runner.html"
    },
    {
      "source": "/specified-commerce.html",
      "destination": "/specified-commerce.html"
    },
    {
      "source": "/404.html",
      "destination": "/404.html"
    },
    {
      "source": "/fix.html",
      "destination": "/fix.html"
    },
    {
      "source": "/services/(.*)",
      "destination": "/services/$1"
    },
    {
      "source": "/login.html",
      "destination": "/login.html"
    },
    {
      "source": "/register.html",
      "destination": "/register.html"
    },
    {
      "source": "/admin-members.html",
      "destination": "/admin-members.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/blog/$1"
    },
    {
      "source": "/news.html",
      "destination": "/news.html"
    },
    {
      "source": "/news/(.*)",
      "destination": "/news/$1"
    },
    {
      "source": "/faq.html",
      "destination": "/faq.html"
    },
    {
      "source": "/about.html",
      "destination": "/about.html"
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing.html"
    },
    {
      "source": "/works.html",
      "destination": "/works.html"
    },
    {
      "source": "/voice.html",
      "destination": "/voice.html"
    },
    {
      "source": "/flow.html",
      "destination": "/flow.html"
    },
    {
      "source": "/contact.html",
      "destination": "/contact.html"
    },
    {
      "source": "/pain.html",
      "destination": "/pain.html"
    },
    {
      "source": "/positioning.html",
      "destination": "/positioning.html"
    },
    {
      "source": "/story.html",
      "destination": "/story.html"
    },
    {
      "source": "/profile.html",
      "destination": "/profile.html"
    },
    {
      "source": "/sitemap.html",
      "destination": "/sitemap.html"
    },
    {
      "source": "/hitblow.html",
      "destination": "/hitblow.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(404|game|racing|runner|hitblow|specified-commerce|fix|login|register|admin-members)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate, no-store"
        }
      ]
    },
    {
      "source": "/(news|content|content-schema)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate, no-store"
        }
      ]
    },
    {
      "source": "/intro.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate, no-store"
        }
      ]
    },
    {
      "source": "/admin-members.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://vercel.com https://www.googleapis.com; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
